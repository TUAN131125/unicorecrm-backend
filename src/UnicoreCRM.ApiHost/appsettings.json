{
  "ConnectionStrings": {
    "UnicoreCRM": ""
  },
  "IdentityAuth": {
    "Jwt": {
      "Issuer": "UnicoreCRM",
      "Audience": "UnicoreCRM.Api",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshTokenPepper": "",
    "Session": {
      "IdleDays": 30,
      "AbsoluteDays": 90
    },
    "AbuseProtection": {
      "Registration": {
        "OriginPermitLimit": 20,
        "SubjectPermitLimit": 5,
        "WindowSeconds": 600
      },
      "VerificationRequest": {
        "OriginPermitLimit": 30,
        "SubjectPermitLimit": 5,
        "WindowSeconds": 600
      },
      "VerificationSubmission": {
        "OriginPermitLimit": 60,
        "SubjectPermitLimit": 10,
        "WindowSeconds": 600
      },
      "PasswordSignIn": {
        "OriginPermitLimit": 60,
        "SubjectPermitLimit": 10,
        "WindowSeconds": 300
      },
      "SessionRefresh": {
        "OriginPermitLimit": 300,
        "SubjectPermitLimit": 60,
        "WindowSeconds": 60
      }
    },
    "EmailVerification": {
      "ExpiryMinutes": 10,
      "MaxAttempts": 5,
      "ResendIntervalSeconds": 60,
      "Sender": {
        "Kind": "Unavailable",
        "Host": "smtp.gmail.com",
        "Port": 587,
        "UseStartTls": true,
        "FromName": "UnicoreCRM",
        "TimeoutSeconds": 30
      },
      "Outbox": {
        "DispatchIntervalSeconds": 15,
        "MaxAttempts": 5,
        "RetryBackoffSeconds": 30,
        "BatchSize": 20,
        "LeaseSeconds": 120
      }
    }
  },
  "Integrations": {
    "Secrets": {}
  },
  "AI": {
    "Provider": {
      "Kind": "Unavailable",
      "TimeoutSeconds": 10
    }
  },
  "Workflows": {
    "InitialWorkspaceProvisioning": {
      "ResumeEnabled": true,
      "ResumeIntervalSeconds": 30,
      "ResumeBatchSize": 50,
      "DevelopmentFaultInjection": {
        "FailAccessAssignment": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
