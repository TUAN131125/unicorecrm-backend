{
  "ConnectionStrings": {
    "UnicoreCRM": ""
  },
  "IdentityAuth": {
    "Jwt": {
      "Issuer": "UnicoreCRM",
      "Audience": "UnicoreCRM.Api",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshTokenPepper": "",
    "Session": {
      "IdleDays": 30,
      "AbsoluteDays": 90
    }
  },
  "Integrations": {
    "Secrets": {}
  },
  "AI": {
    "Provider": {
      "Kind": "Unavailable",
      "TimeoutSeconds": 10
    }
  },
  "Workflows": {
    "InitialWorkspaceProvisioning": {
      "ResumeEnabled": true,
      "ResumeIntervalSeconds": 30,
      "ResumeBatchSize": 50,
      "DevelopmentFaultInjection": {
        "FailAccessAssignment": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
