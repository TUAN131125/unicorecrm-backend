{
  // Credential-free local default. A developer who targets a different SQL Server instance, or one
  // that needs SQL authentication, overrides this in appsettings.Development.Local.json, which is
  // never tracked. No real connection secret belongs in this file.
  "ConnectionStrings": {
    "UnicoreCRM": "Server=(localdb)\\MSSQLLocalDB;Database=UnicoreCRM_Development;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Development": {
    "ApplyMigrations": true
  },

  "IdentityAuth": {
    "Jwt": {
      "SigningKey": "local-development-only-jwt-signing-key-not-for-any-deployed-environment"
    },
    "RefreshTokenPepper": "local-development-only-refresh-token-pepper-not-for-any-deployed-environment",
    "EmailVerification": {
      "ExpiryMinutes": 10,
      "MaxAttempts": 5,
      "ResendIntervalSeconds": 60,
      "Sender": {
        "Kind": "GmailSmtp",
        "Host": "smtp.gmail.com",
        "Port": 587,
        "UseStartTls": true,
        "FromName": "UnicoreCRM",
        "TimeoutSeconds": 15
      }
    }
  },

  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },

  "AI": {
    "Provider": {
      "Kind": "DevelopmentDeterministic",
      "DevelopmentMode": "Normal",
      "TimeoutSeconds": 10
    }
  },

  // The demo fixture seeds a local sign-in account. Its password is a credential, so it lives only
  // in appsettings.Development.Local.json; without it the whole fixture is skipped and the host
  // still starts normally.
  "DevelopmentDemoBootstrap": {
    "Email": "admin@unicorecrm.local",
    "DisplayName": "Unicore Demo User",

    "RoleName": "Unicore Demo Operator",

    "Workspace": {
      "Key": "unicore-demo",
      "Name": "Unicore Demo Workspace",
      "LogoText": "UD",
      "Locale": "en",
      "TimeZone": "Asia/Saigon",
      "BaseCurrency": "USD",
      "EnabledModuleKeys": [
        "contacts",
        "leads",
        "deals",
        "tasks",
        "products"
      ],
      "AvailableProductSpaces": [
        "crm"
      ]
    },

    "IsolationWorkspace": {
      "Key": "unicore-demo-isolated",
      "Name": "Unicore Demo Isolated Workspace",
      "LogoText": "UI",
      "Locale": "en",
      "TimeZone": "Asia/Saigon",
      "BaseCurrency": "USD",
      "AvailableProductSpaces": [
        "crm"
      ]
    },

    "Capabilities": [
      "workspace.context.resolve",
      "contacts.read",
      "tasks.read",
      "tasks.create",
      "tasks.update",
      "tasks.assign",
      "tasks.complete",
      "leads.read",
      "leads.create",
      "leads.update",
      "leads.qualify",
      "deals.read",
      "deals.create",
      "deals.update",
      "deals.assign",
      "deals.close",
      "deals.delete",
      "deals.bulk",
      "products.read",
      "products.create",
      "products.edit",
      "products.delete",
      "support.read",
      "support.create",
      "support.update",
      "support.assign"
    ]
  }
}
