// Template for local developer secrets. PLACEHOLDERS ONLY - never put a real credential in this
// file, because this file IS tracked.
//
// Usage:
//   1. Copy this file to appsettings.Development.Local.json in the same folder.
//   2. Replace every YOUR_* placeholder with your real local value.
//   3. Delete any section you do not need; every section is optional.
//
// appsettings.Development.Local.json is ignored by .gitignore and is loaded only in the Development
// environment, after appsettings.json and appsettings.Development.json, so anything set here
// overrides the tracked defaults. Environment variables still win over this file, so the
// scripts/verify-*.ps1 harnesses keep driving their own isolated databases.
{
  // Omit this section entirely to keep the tracked credential-free LocalDB default.
  "ConnectionStrings": {
    "UnicoreCRM": "Server=YOUR_SERVER;Database=UnicoreCRM_Development;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  // Password for the seeded local demo sign-in account. The tracked configuration supplies the
  // fixture's email, display name, workspace and capabilities; only the password lives here.
  // Without it the demo fixture is skipped and the host still starts normally.
  "DevelopmentDemoBootstrap": {
    "Password": "YOUR_LOCAL_DEMO_PASSWORD"
  },

  "IdentityAuth": {
    "EmailVerification": {
      "Sender": {
        // "DevelopmentLog" (the tracked default) writes the verification code to the backend
        // console and sends nothing. "GmailSmtp" delivers a real email and needs the credentials
        // below. "Unavailable" fails every request closed.
        "Kind": "GmailSmtp",

        // Host, Port, UseStartTls, FromName and TimeoutSeconds already have Gmail-shaped defaults
        // in the tracked appsettings.json; override them here only if you need to.
        //
        // AppPassword is a 16-character Google App Password (https://myaccount.google.com/apppasswords),
        // not your Google account password, and requires 2-Step Verification on the account.
        // Gmail rejects a normal account password on SMTP.
        "Username": "YOUR_GMAIL@gmail.com",
        "AppPassword": "YOUR_GOOGLE_APP_PASSWORD",
        "FromAddress": "YOUR_GMAIL@gmail.com"
      }
    }
  }
}
