+    public async Task RecordAuditOnceAsync(ProactiveAuditEvidence audit, CancellationToken ct)
+    {
+        if (await db.ProactiveAudits.AsNoTracking().AnyAsync(x => x.AuditId == audit.AuditId, ct)) return;
+        var row = Row(audit);
+        db.ProactiveAudits.Add(row);
