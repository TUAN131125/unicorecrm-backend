+[CmdletBinding()]
+param([string]$SqlServer = 'localhost', [int]$Port = 5389, [switch]$Browser, [switch]$ScaleReview, [switch]$ProjectionReview, [switch]$RaceReview, [switch]$UiReview)
+$ErrorActionPreference = 'Stop'
+$runId = [Guid]::NewGuid().ToString('N')
+$startedAt = [DateTimeOffset]::UtcNow.ToString('O')
