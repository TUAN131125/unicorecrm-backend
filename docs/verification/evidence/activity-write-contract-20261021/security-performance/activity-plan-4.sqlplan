<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT [u].[ActivityId], [u].[ActorId], [u].[Body], [u].[OccurredAt], [u].[RecordId], [u].[RecordLabel], [u].[RecordModuleKey], [u].[RelationshipId], [u].[RelationshipType], [u].[SourceEvidence], [u].[SourceId], [u].[SourceType], [u].[Subject], [u].[Type], [u].[Version], [u].[WorkspaceId]&#xd;&#xa;FROM (&#xd;&#xa;    SELECT a.* FROM tasks.Activities a&#xd;&#xa;    WHERE a.WorkspaceId=@activityWorkspace AND a.Type&lt;&gt;5&#xd;&#xa;      AND a.SourceEvidence IS NULL&#xd;&#xa;      AND ((a.SourceType IS NULL AND a.SourceId IS NULL) OR&#xd;&#xa;           (a.SourceId=COALESCE(a.RecordId,a.RelationshipId) AND&#xd;&#xa;            ((COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;leads&apos; AND a.SourceType IN (N&apos;LEAD_ACTIVITY&apos;,N&apos;LEAD_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;contacts&apos; AND a.SourceType IN (N&apos;CONTACT_ACTIVITY&apos;,N&apos;CONTACT_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;organizations&apos; AND a.SourceType IN (N&apos;ORGANIZATION_ACTIVITY&apos;,N&apos;ORGANIZATION_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;customers&apos; AND a.SourceType IN (N&apos;CUSTOMER_ACTIVITY&apos;,N&apos;CUSTOMER_DETAIL&apos;,N&apos;CUSTOMER_360&apos;)))))&#xd;&#xa;      AND EXISTS (SELECT 1 FROM (SELECT @module0 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT WorkspaceId, CustomerId AS RecordId, OwnerId, CASE WHEN Status IN (N&apos;NEW&apos;,N&apos;ACTIVE&apos;,N&apos;INACTIVE&apos;) THEN 1 ELSE 0 END AS CanLog, RelationshipType, RelationshipId FROM customers.Customers) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned0=0 OR f.OwnerId=@owner0 OR (@queue0=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict0=0 OR @queue0=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      &#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT @module1 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;CONTACT&apos; AS RelationshipType, c.ContactId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c&#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; AND r.EffectiveTo IS NULL THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;ORGANIZATION_ACCOUNT&apos; AS RelationshipType, r.OrganizationId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c INNER JOIN contacts.OrganizationRelationships r&#xd;&#xa;        ON r.WorkspaceId=c.WorkspaceId AND r.ContactId=c.ContactId) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned1=0 OR f.OwnerId=@owner1 OR (@queue1=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict1=0 OR @queue1=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      ) p&#xd;&#xa;                  WHERE p.ModuleKey=COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END) AND p.RecordId=COALESCE(a.RecordId,a.RelationshipId)&#xd;&#xa;                    AND (a.RelationshipType IS NULL OR&#xd;&#xa;                         (p.RelationshipType=a.RelationshipType AND p.RelationshipId=a.RelationshipId)))&#xd;&#xa;      AND (a.RelationshipType IS NULL OR&#xd;&#xa;           EXISTS (SELECT 1 FROM (SELECT @module0 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT WorkspaceId, CustomerId AS RecordId, OwnerId, CASE WHEN Status IN (N&apos;NEW&apos;,N&apos;ACTIVE&apos;,N&apos;INACTIVE&apos;) THEN 1 ELSE 0 END AS CanLog, RelationshipType, RelationshipId FROM customers.Customers) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned0=0 OR f.OwnerId=@owner0 OR (@queue0=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict0=0 OR @queue0=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      &#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT @module1 AS" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x090042AA24765C9BCDB04F46428A145E1E490000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="false" StatementSubTreeCost="0.250677" StatementEstRows="2" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA4A5FE833455E7E8" QueryPlanHash="0xEA53DAA3CEF1D869" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="216" CompileTime="96" CompileCPU="95" CompileMemory="4152"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="102431" EstimatedPagesCached="102431" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="151608"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-21T18:31:02.28" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_NormalizedWorkEmail]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:30:50.83" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_0000000B_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:30:50.80" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_00000008_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:31:02.28" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_FullName_ContactId]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:30:33.04" ModificationCount="3" SamplingPercent="100" Statistics="[PK_Customers]" Table="[Customers]" Schema="[customers]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:30:50.79" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_0000000A_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T18:30:50.76" ModificationCount="1000" SamplingPercent="100" Statistics="[IX_Activities_RecordHistory]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_3dd6e8153b3d40e98e7851aba2de7237]"></