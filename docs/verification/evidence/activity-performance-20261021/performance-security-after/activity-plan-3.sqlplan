<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT COUNT(*)&#xd;&#xa;FROM (&#xd;&#xa;    SELECT a.* FROM tasks.Activities a&#xd;&#xa;    WHERE a.WorkspaceId=@activityWorkspace AND a.Type&lt;&gt;5&#xd;&#xa;      AND a.SourceEvidence IS NULL&#xd;&#xa;      AND ((a.SourceType IS NULL AND a.SourceId IS NULL) OR&#xd;&#xa;           (a.SourceId=COALESCE(a.RecordId,a.RelationshipId) AND&#xd;&#xa;            ((COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;leads&apos; AND a.SourceType IN (N&apos;LEAD_ACTIVITY&apos;,N&apos;LEAD_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;contacts&apos; AND a.SourceType IN (N&apos;CONTACT_ACTIVITY&apos;,N&apos;CONTACT_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;organizations&apos; AND a.SourceType IN (N&apos;ORGANIZATION_ACTIVITY&apos;,N&apos;ORGANIZATION_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;customers&apos; AND a.SourceType IN (N&apos;CUSTOMER_ACTIVITY&apos;,N&apos;CUSTOMER_DETAIL&apos;,N&apos;CUSTOMER_360&apos;)))))&#xd;&#xa;      AND EXISTS (SELECT 1 FROM (SELECT @module0 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT WorkspaceId, LeadId AS RecordId, ScopeOwnerId AS OwnerId, CASE WHEN ArchivedAt IS NULL THEN 1 ELSE 0 END AS CanLog, RelationshipType, RelationshipId FROM leads.Leads) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned0=0 OR f.OwnerId=@owner0 OR (@queue0=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict0=0 OR @queue0=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      &#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT @module1 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT WorkspaceId, CustomerId AS RecordId, OwnerId, CASE WHEN Status IN (N&apos;NEW&apos;,N&apos;ACTIVE&apos;,N&apos;INACTIVE&apos;) THEN 1 ELSE 0 END AS CanLog, RelationshipType, RelationshipId FROM customers.Customers) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned1=0 OR f.OwnerId=@owner1 OR (@queue1=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict1=0 OR @queue1=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      &#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT @module2 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT WorkspaceId, OrganizationId AS RecordId, OwnerId, CASE WHEN Status&lt;&gt;N&apos;archived&apos; THEN 1 ELSE 0 END AS CanLog, N&apos;ORGANIZATION_ACCOUNT&apos; AS RelationshipType, OrganizationId AS RelationshipId FROM organizations.Organizations) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned2=0 OR f.OwnerId=@owner2 OR (@queue2=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict2=0 OR @queue2=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      &#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT @module3 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;CONTACT&apos; AS RelationshipType, c.ContactId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c&#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; AND r.EffectiveTo IS NULL THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;ORGANIZATION_ACCOUNT&apos; AS RelationshipType, r.OrganizationId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c INNER JOIN contacts.OrganizationRelationships r&#xd;&#xa;        ON r.WorkspaceId=c.WorkspaceId AND r.ContactId=c.ContactId) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned3=0 OR f.OwnerId=@owner3 OR (@queue3=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict3=0 OR @queue3=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      ) p&#xd;&#xa;                  WHERE p.ModuleKey=COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END) AND p.RecordId=COALESCE(a.RecordId,a.RelationshipId)&#xd;&#xa;           " StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900943F351E32469399D17647EAAED7F10D0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="false" StatementSubTreeCost="0.974869" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x0B2D1E81C26B86E0" QueryPlanHash="0x7A3CBF6B21502C67" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="280" CompileTime="163" CompileCPU="161" CompileMemory="4824"><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="1728" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="102431" EstimatedPagesCached="102431" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="125856"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-21T17:19:13.50" ModificationCount="1" SamplingPercent="100" Statistics="[IX_Leads_WorkspaceId_ArchivedAt_UpdatedAt_LeadId]" Table="[Leads]" Schema="[leads]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:40.19" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_5E8A0973]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:41.09" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000005_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:40.17" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:14.45" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000E_2A164134]" Table="[Leads]" Schema="[leads]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:39.67" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_NormalizedWorkEmail]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:40.22" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000B_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:14.46" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Leads_WorkspaceId_ScopeOwnerId_ArchivedAt_UpdatedAt_LeadId]" Table="[Leads]" Schema="[leads]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:40.14" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000A_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:39.67" ModificationCount="0" SamplingPercent="100" Statistics="[AK_Contacts_WorkspaceId_ContactId]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:39.65" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_OwnerId_CreatedAt_ContactId]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:14.47" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000010_2A164134]" Table="[Leads]" Schema="[leads]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:14.45" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000009_51300E55]" Table="[Organizations]" Schema="[organizations]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:14.47" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000F_2A164134]" Table="[Leads]" Schema="[leads]" Database="[UnicoreCRM_ActivityTest_b66784440f094da8ad3e51ed9ead21bb]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:19:40.15" Mod