<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT [u].[ActivityId], [u].[ActorId], [u].[Body], [u].[OccurredAt], [u].[RecordId], [u].[RecordLabel], [u].[RecordModuleKey], [u].[RelationshipId], [u].[RelationshipType], [u].[SourceEvidence], [u].[SourceId], [u].[SourceType], [u].[Subject], [u].[Type], [u].[Version], [u].[WorkspaceId]&#xd;&#xa;FROM (&#xd;&#xa;    SELECT a.* FROM tasks.Activities a&#xd;&#xa;    WHERE a.WorkspaceId=@activityWorkspace AND a.Type&lt;&gt;5&#xd;&#xa;      AND a.SourceEvidence IS NULL&#xd;&#xa;      AND ((a.SourceType IS NULL AND a.SourceId IS NULL) OR&#xd;&#xa;           (a.SourceId=COALESCE(a.RecordId,a.RelationshipId) AND&#xd;&#xa;            ((COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;leads&apos; AND a.SourceType IN (N&apos;LEAD_ACTIVITY&apos;,N&apos;LEAD_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;contacts&apos; AND a.SourceType IN (N&apos;CONTACT_ACTIVITY&apos;,N&apos;CONTACT_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;organizations&apos; AND a.SourceType IN (N&apos;ORGANIZATION_ACTIVITY&apos;,N&apos;ORGANIZATION_DETAIL&apos;)) OR&#xd;&#xa;             (COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END)=N&apos;customers&apos; AND a.SourceType IN (N&apos;CUSTOMER_ACTIVITY&apos;,N&apos;CUSTOMER_DETAIL&apos;,N&apos;CUSTOMER_360&apos;)))))&#xd;&#xa;      AND EXISTS (SELECT 1 FROM (SELECT @module0 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;CONTACT&apos; AS RelationshipType, c.ContactId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c&#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; AND r.EffectiveTo IS NULL THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;ORGANIZATION_ACCOUNT&apos; AS RelationshipType, r.OrganizationId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c INNER JOIN contacts.OrganizationRelationships r&#xd;&#xa;        ON r.WorkspaceId=c.WorkspaceId AND r.ContactId=c.ContactId) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned0=0 OR f.OwnerId=@owner0 OR (@queue0=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict0=0 OR @queue0=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      ) p&#xd;&#xa;                  WHERE p.ModuleKey=COALESCE(a.RecordModuleKey, CASE a.RelationshipType WHEN N&apos;CONTACT&apos; THEN N&apos;contacts&apos; WHEN N&apos;ORGANIZATION_ACCOUNT&apos; THEN N&apos;organizations&apos; END) AND p.RecordId=COALESCE(a.RecordId,a.RelationshipId)&#xd;&#xa;                    AND (a.RelationshipType IS NULL OR&#xd;&#xa;                         (p.RelationshipType=a.RelationshipType AND p.RelationshipId=a.RelationshipId)))&#xd;&#xa;      AND (a.RelationshipType IS NULL OR&#xd;&#xa;           EXISTS (SELECT 1 FROM (SELECT @module0 AS ModuleKey, f.RecordId, f.RelationshipType, f.RelationshipId&#xd;&#xa;    FROM (SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;CONTACT&apos; AS RelationshipType, c.ContactId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c&#xd;&#xa;    UNION ALL&#xd;&#xa;    SELECT c.WorkspaceId, c.ContactId AS RecordId, c.OwnerId, CASE WHEN c.ArchivedAt IS NULL AND c.Status&lt;&gt;N&apos;archived&apos; AND r.EffectiveTo IS NULL THEN 1 ELSE 0 END AS CanLog,&#xd;&#xa;        N&apos;ORGANIZATION_ACCOUNT&apos; AS RelationshipType, r.OrganizationId AS RelationshipId&#xd;&#xa;    FROM contacts.Contacts c INNER JOIN contacts.OrganizationRelationships r&#xd;&#xa;        ON r.WorkspaceId=c.WorkspaceId AND r.ContactId=c.ContactId) f&#xd;&#xa;    WHERE f.WorkspaceId=@activityWorkspace&#xd;&#xa;      AND (@owned0=0 OR f.OwnerId=@owner0 OR (@queue0=1 AND f.OwnerId IS NULL))&#xd;&#xa;      AND (@restrict0=0 OR @queue0=1 OR f.OwnerId IS NOT NULL)&#xd;&#xa;      ) r&#xd;&#xa;                   WHERE r.RecordId=a.RelationshipId AND" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09008B7993CCF7DE36E95FDB4C48D5A051160000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="false" StatementSubTreeCost="0.21661" StatementEstRows="2" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xBC6D7A424F68583D" QueryPlanHash="0xDC50A14F877E42F2" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="176" CompileTime="112" CompileCPU="111" CompileMemory="3264"><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="102431" EstimatedPagesCached="102431" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="131472"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-10-21T17:45:20.23" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_CreatedAt_ContactId]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:06.15" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_00000003_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:20.24" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_NormalizedWorkEmail]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:07.06" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_00000005_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:20.25" ModificationCount="0" SamplingPercent="100" Statistics="[IX_Contacts_WorkspaceId_UpdatedAt_ContactId]" Table="[Contacts]" Schema="[contacts]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:09.14" ModificationCount="1000" SamplingPercent="100" Statistics="[PK_Activities]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201ddc8ef68]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-21T17:45:06.13" ModificationCount="1000" SamplingPercent="100" Statistics="[_WA_Sys_0000000D_7814D14C]" Table="[Activities]" Schema="[tasks]" Database="[UnicoreCRM_ActivityTest_81619fa3ec4f4acdaf98c201